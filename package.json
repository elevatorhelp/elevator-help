{
  "name": "elevator-help",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test:language": "node --experimental-strip-types scripts/test-german-language.ts",
    "test:gemini-cost-control": "node --experimental-strip-types scripts/test-gemini-cost-control.ts",
    "test:conversation-edit": "node --experimental-strip-types scripts/test-conversation-edit.ts",
    "test:starter-actions": "node --experimental-strip-types scripts/test-starter-actions.ts",
    "test:request-auth": "node --experimental-strip-types scripts/test-request-auth.ts",
    "test:security": "node scripts/test-security-baseline.mjs && npm audit --omit=dev --audit-level=high",
    "test:incremental-ingestion": "node scripts/test-incremental-ingestion.mjs",
    "test:multilingual-retrieval": "node --experimental-strip-types scripts/test-multilingual-retrieval.ts",
    "test:standards-presentation": "node --experimental-strip-types scripts/test-standards-presentation.ts",
    "test:cortex-standards": "node --experimental-strip-types scripts/test-cortex-standards.ts",
    "test:reference-index": "node --experimental-strip-types scripts/test-reference-index.ts",
    "test:domain-pack": "node --experimental-strip-types scripts/test-domain-pack.ts",
    "test:cortex-evidence-policy": "node --experimental-strip-types scripts/test-cortex-evidence-policy.ts",
    "test:daily-question-quota": "node --experimental-strip-types scripts/test-daily-question-quota.ts",
    "test:cortex-learning": "node --experimental-strip-types scripts/test-cortex-learning.ts",
    "test:safe-markdown": "node --experimental-strip-types scripts/test-safe-markdown.ts",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "test:worker-leases": "node --test scripts/test-offline-worker-leases.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "^7.9.14",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  }
}
