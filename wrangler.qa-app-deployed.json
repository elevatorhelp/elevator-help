{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elevator-help-pr61-app-qa",
  "main": "workers/qa-real-app-entry.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "CORTEX_DB",
      "database_name": "elevator-help-lease-test-01",
      "database_id": "02716877-15e3-4478-9e24-f1ba6e5dfb00"
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "AUTH_REQUIRED": "false",
    "INGESTION_STAGED_PUBLICATION": "true",
    "INGESTION_COMPLETE_PUBLICATION": "true",
    "INGESTION_LEASE_PREFLIGHT": "true",
    "GEMINI_MAX_CALLS_PER_INGEST_REQUEST": "3"
  },
  "ratelimits": [
    {
      "name": "GEMINI_ASK_RATE_LIMITER",
      "namespace_id": "24001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "elevator-help-staging-test"
    },
    {
      "binding": "VECTORIZE_V2",
      "index_name": "elevator-help-staging-test"
    }
  ],
  "workers_dev": true
}
