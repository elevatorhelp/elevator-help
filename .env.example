# Public at build time. Add the same value as a GitHub Actions secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-side secret. Store as a Cloudflare Worker secret, never in Git.
CLERK_SECRET_KEY=

# Keep false until Clerk production DNS and email verification are confirmed.
AUTH_REQUIRED=false

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
