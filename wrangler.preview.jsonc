{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elevator-help-qa-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "CORTEX_DB",
      "database_name": "elevator-help-cortex-preview",
      "database_id": "4997e193-045c-4daa-bec3-b5a15ddfd5ed"
    }
  ],
  "vars": {
    "AUTH_REQUIRED": "true",
    "DAILY_QUESTION_LIMIT_ENABLED": "true",
    "DAILY_QUESTION_LIMIT": "10",
    "CORTEX_LEARNING_ENABLED": "true",
    "MULTILINGUAL_RETRIEVAL_ENABLED": "true",
    "GEMINI_MAX_CALLS_PER_QUESTION": "5",
    "GEMINI_MAX_CALLS_PER_INGEST_REQUEST": "3"
  },
  "ai": {"binding": "AI"},
  "vectorize": [
    {"binding": "VECTORIZE", "index_name": "elevator-help-index"},
    {"binding": "VECTORIZE_V2", "index_name": "elevator-help-multilingual-v2"}
  ]
}
