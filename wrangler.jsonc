{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "elevator-help",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"MULTILINGUAL_RETRIEVAL_ENABLED": "true"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "elevator-help-index"
		},
		{
			"binding": "VECTORIZE_V2",
			"index_name": "elevator-help-multilingual-v2"
		}
	]
}
